        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "Just some business to attend.  Now either I can\u2019t believe my
          eyes, or you\u2019re actually working on a map there! I was starting to
          think you\u2019d never take on the Cucumella birthright!"
        type: 0
